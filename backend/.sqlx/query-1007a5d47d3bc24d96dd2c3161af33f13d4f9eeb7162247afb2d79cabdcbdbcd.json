  "query": "\n        SELECT u.username,\n               t.confirmed_at IS NOT NULL AS \"totp_enabled!: bool\",\n               u.created_at AS \"created_at: _\"\n          FROM users u\n          LEFT JOIN user_totp t ON t.user_id = u.id\n         ORDER BY u.username\n        ",
